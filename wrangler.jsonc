{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saaf-saans",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],

  // Writes the files in public/ that are generated from src/ (see
  // scripts/build-assets.mjs) before every `wrangler dev` and `wrangler deploy`.
  "build": {
    "command": "npm run build",
  },

  // Static single-page app. `run_worker_first` is scoped to the API so asset
  // requests are served straight from the edge without invoking the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },

  // Inference on Workers AI. This is a binding, not an API key. Which models
  // are asked, and in what order, is set in src/config/runtime.ts.
  "ai": {
    "binding": "AI",
  },

  // The service has one secret, and it is optional: NVIDIA_API_KEY. When it is
  // set (`npx wrangler secret put NVIDIA_API_KEY`), NVIDIA's hosted API is
  // asked first and Workers AI second; without it the assistant runs on Workers
  // AI alone. It is a Worker secret, so it is in no file of this repository,
  // not in CI and not in the deployed bundle. .dev.vars.example names it for
  // local use.

  // Per-IP request cap on the API. Thirty a minute is far above a household
  // checking its air and far below a flood; static assets are unaffected.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  "upload_source_maps": true,
}
