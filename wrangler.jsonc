{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saaf-saans",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],

  // Writes the files in public/ that are generated from src/ (see
  // scripts/build-assets.mjs) before every `wrangler dev` and `wrangler deploy`.
  "build": {
    "command": "npm run build",
  },

  // Static single-page app. `run_worker_first` is scoped to the API so asset
  // requests are served straight from the edge without invoking the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },

  // Inference. This is a binding, not an API key: there is no credential in
  // this repository, in CI, or in the deployed bundle. Which models are asked,
  // and in what order, is set by MODELS in src/config/runtime.ts.
  "ai": {
    "binding": "AI",
  },

  // Per-IP request cap on the API. Thirty a minute is far above a household
  // checking its air and far below a flood; static assets are unaffected.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  "upload_source_maps": true,
}
